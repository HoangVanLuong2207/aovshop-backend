{
    "name": "aovshop-backend",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node startup.js",
        "db:push": "drizzle-kit push",
        "db:seed": "tsx src/db/seed.ts",
        "db:migrate-push": "tsx src/db/migrate-push.ts",
        "db:migrate-daily-limit": "tsx src/db/migrate-daily-limit.ts",
        "db:migrate-minimum-order-quantity": "tsx src/db/migrate-minimum-order-quantity.ts",
        "db:migrate-google-auth": "tsx src/db/migrate-google-auth.ts",
        "test": "npm run build && node tests/run-security.mjs",
        "db:migrate-security": "tsx src/db/migrate-security.ts"
    },
    "dependencies": {
        "@libsql/client": "^0.14.0",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "drizzle-kit": "^0.31.10",
        "drizzle-orm": "^0.45.2",
        "express": "^4.21.2",
        "express-rate-limit": "^8.2.1",
        "google-auth-library": "^11.0.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.0.2",
        "resend": "^6.6.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "web-push": "^3.6.7",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.10.2",
        "@types/web-push": "^3.6.4"
    },
    "overrides": {
        "esbuild": "^0.25.12"
    }
}
