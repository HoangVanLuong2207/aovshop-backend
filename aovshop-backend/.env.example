# ==================================
# Backend Environment Variables
# ==================================
# Copy file này thành .env và điền giá trị

# ─── BẮT BUỘC ─────────────────────

# Database (Turso/LibSQL)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Frontend URL (dùng cho link trong email xác thực, reset password)
FRONTEND_URL=https://your-frontend-domain.com


# Tài khoản Admin từ ENV (không lưu trong DB, luôn có role admin)
# Bắt buộc điền cả hai giá trị khi dùng đăng nhập admin từ ENV.
ADMIN_EMAIL=admin@aovshop.com
ADMIN_PASSWORD=admin123

# ─── TỰ ĐỘNG (không cần nhập) ─────

# JWT_SECRET — tự động tạo và lưu trong database khi khởi động lần đầu
# Nếu muốn tự đặt, bỏ comment dòng dưới:
# JWT_SECRET=your-secret-key-32-characters

# ─── CẤU HÌNH QUA ADMIN PANEL ─────

# Các cấu hình sau được quản lý qua giao diện Admin → Cài đặt:
# - 📧 Email (Brevo): API Key, Email người gửi
# - 🤖 Telegram Bot: Bot Token, Chat ID
# - 💳 Ngân hàng (SePay): Merchant ID, Secret Key, STK
# - 🏪 Thông tin Shop: Tên, Logo, Banner
# - 📞 Liên hệ: Zalo, Facebook, Hotline
# - 🔑 API Token: Mã xác thực cho tool
